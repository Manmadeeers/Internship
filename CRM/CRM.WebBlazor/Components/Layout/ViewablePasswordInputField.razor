@inject IStringLocalizer<Resource> Localizer


<MudTextField T="string" Label="@Localizer[Label]" 
              Adornment="Adornment.End" AdornmentIcon="@_passwordInputIcon" OnAdornmentClick="@ChangePasswordVisibility" 
              Value="@Value" ValueChanged="@ValueChanged"
              InputType="@_passwordInput" 
              Validation="@ConditionalValidation"
              Required="true" 
              RequiredError="@Localizer[MessageRequired]"
              Class="mt-4" />



@code {
    [Parameter,EditorRequired] 
    public string? Value {get; set;}
    
    [Parameter]
    public EventCallback<string?> ValueChanged {get; set;}

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string ValidationMessage { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string MessageRequired { get; set; } = string.Empty;
    
    [Parameter]
    public Func<string,string?>?ValidationCallback { get; set; }
    
    
    private InputType _passwordInput = InputType.Password;
    private  string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private bool _isPasswordShow;

    private object ConditionalValidation =>
        ValidationCallback is not null
            ? ValidationCallback
            : new PasswordAttribute
            {
                ErrorMessage = Localizer[ValidationMessage]
            };
    
    
    
    private void ChangePasswordVisibility()
    {
        _isPasswordShow = !_isPasswordShow;
        _passwordInput = _isPasswordShow ? InputType.Text:InputType.Password;
        _passwordInputIcon = _isPasswordShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        
    }
}

