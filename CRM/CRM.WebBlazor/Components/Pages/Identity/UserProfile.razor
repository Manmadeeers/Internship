@page "/identity/user-profile"
@using CRM.WebBlazor.Service.Identity

@inject  IStringLocalizer<Resource> Localizer
@inject NavigationManager NavManager
@inject IFileService FileService
@inject IUserService UserService
@inject ISnackbar Snackbar


<MudPaper Style="position:relative;" Class="pa-4" Outlined="false" Square="false" Elevation="0">
    <MudText Typo="Typo.h3">@Localizer["title-user-profile"]</MudText>
    <MudPaper Class="pa-4 my-2 text-center" Outlined="false" Square="false" Elevation="0">
        <MudBadge Color="@(_viewModel.IsActive == true ? Color.Success : Color.Dark)" Overlap="true" Bordered="true">
            <MudAvatar Style="height:70px; width:70px;" Color="Color.Primary" Variant="Variant.Outlined">
                <MudImage Src="@_imageSrc" Alt="@_viewModel.FullName" Fluid="true" Class="rounded-lg" />
            </MudAvatar>
        </MudBadge>
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadImage">
            <ActivatorContent>
                <MudIconButton Color="Color.Primary" Icon="@Icons.Material.Filled.PhotoCamera"></MudIconButton>
            </ActivatorContent>
        </MudFileUpload>
        <MudText Typo="Typo.subtitle1">@_viewModel.FullName</MudText>
        <MudText Typo="Typo.subtitle2">@_viewModel.Email</MudText>
    </MudPaper>
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
        <MudTabPanel Text="@Localizer["tab-details"]" Icon="@Icons.Material.Filled.RemoveRedEye">@* Detail panel *@
            <MudGrid>
                <MudItem xs="12" lg="6">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.subtitle2"><b>@Localizer["label-full-name"]:</b> @_viewModel.FullName</MudText>
                            <MudText Typo="Typo.subtitle2"><b>@Localizer["label-date-of-birth"]:</b> @_viewModel.DateOfBirth?.ToString("d")</MudText>
                            <MudText Typo="Typo.subtitle2"><b>@Localizer["label-date-of-register"]:</b> @_viewModel.RegistrationDate?.ToString("d")</MudText>
                            <MudText Typo="Typo.subtitle2">
                                <b>@Localizer["label-status"]:</b>
                                @if (_viewModel.IsActive == true)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">@Localizer["status-active"]</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error">@Localizer["status-inactive"]</MudChip>
                                }
                            </MudText>
                            <MudText Typo="Typo.subtitle2"><b>@Localizer["label-description"]:</b></MudText>
                            
                            <MudText Typo="Typo.body2" Align="Align.Justify">@_viewModel.ProfileDescription</MudText>
                        </MudStack>
                    </MudPaper> 
                </MudItem>
                <MudItem xs="12" lg="6">
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@Localizer["tab-update"]" Icon="@Icons.Material.Filled.Edit">@* Edit panel *@
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudForm @ref="_formUpdate" @bind-IsValid="@_success" @bind-Errors="@_updateErrors" Model="@_updateModel" Disabled="@_loading">
                            <MudTextField T="string" Label="@Localizer["input-firstname"]"
                            @bind-Value="_updateModel.FirstName"
                            InputType="InputType.Text"
                            Required="true"
                            RequiredError="@Localizer["message-firstname-required"]"
                            Class="mt-4" />

                            <MudTextField T="string" Label="@Localizer["input-lastname"]"
                            @bind-Value="_updateModel.LastName"
                            InputType="InputType.Text"
                            Required="true"
                            RequiredError="@Localizer["message-lastname-required"]"
                            Class="mt-4" />

                            <MudSelect FieldId="genderSelect" T="string" Label="@Localizer["input-gender"]"
                            @bind-Value="_selectedGender" Class="mt-4">
                                @foreach (var gender in GetLocalizedGenderArrayFromEnum())
                                {
                                    <MudSelectItem T="string" Value="@gender.Key.ToString()">@gender.Value</MudSelectItem>
                                }
                            </MudSelect>
                            <MudDatePicker T="DateTime" Label="@Localizer["input-date-of-birth"]"
                            @bind-Date="_updateModel.DateOfBirth"
                            Class="mt-4" />
                            <MudTextField
                                T="string"
                                Label="@Localizer["label-description"]"
                                @bind-Value="_updateModel.ProfileDescription"
                                Lines="5"
                                MaxLength="500"
                                Class="mt-4"/>
                            
                            <div class="d-flex align-center justify-space-between mt-4">
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false" Class="mx-2"
                                OnClick="@(()=>ResetForm(_formUpdate))">@Localizer["button-reset"]</MudButton>

                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success)" Class="ml-auto"
                                OnClick="@(async () => await SubmitFormUpdate())">@Localizer["button-update"]</MudButton>
                            </div>
                        </MudForm>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <ErrorDisplay Errors="_updateErrors" Elevation="0" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@Localizer["tab-change-password"]" Icon="@Icons.Material.Filled.Key">@* Change password panel *@
            <MudGrid>
                <MudItem xs="12" lg="7">
                    <MudPaper Elevation="0" Class="pa-4">
                        <MudForm @ref="_formChangePassword" @bind-IsValid="@_success" @bind-Errors="@_passwordErrors" Model="@_changePasswordModel" Disabled="@_loading">
                            <ViewablePasswordInputField
                                Label="input-current-password"
                                @bind-Value="_changePasswordModel.CurrentPassword"
                                ValidationMessage="message-password-validation"
                                MessageRequired="message-password-required"/>
                            
                            <ViewablePasswordInputField
                                Label="input-password"
                                @bind-Value="_changePasswordModel.NewPassword"
                                ValidationMessage="message-password-validation"
                                MessageRequired="message-password-required"/>
                            
                            <ViewablePasswordInputField
                                @bind-Value="_confirmPassword"
                                Label="input-confirm-password"
                                ValidationCallback="@PasswordMatch"
                                ValidationMessage=""
                                MessageRequired="message-confirm-password-required"/>
                            
                            <div class="d-flex align-center justify-space-between mt-4">
                                <MudSpacer/>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false" Class="mx-2"
                                           OnClick="@(() => ResetForm(_formChangePassword))">@Localizer["button-reset"]</MudButton>

                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_success)"
                                           OnClick="@SubmitFormChangePassword">@Localizer["button-change-password"]</MudButton>
                            </div>
                        </MudForm>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" lg="5">
                    <ErrorDisplay Errors="_passwordErrors" Elevation="0" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </MudTabs>
    <LoadingSpinner Loading="_loading" />
</MudPaper>


@code{

    protected override async Task OnAfterRenderAsync(bool firstRender)
    { 
        
        if (firstRender)
        {
            _loading = true;
            StateHasChanged();
            
            var responseModel = await UserService.GetUserProfileAsync();
            if (!responseModel.IsSuccess || responseModel.Data is null)
            {
                Snackbar.Add(responseModel.Message ?? "Unable to load profile", Severity.Error);
                NavManager.NavigateTo("/identity/login");
                return;
            }

            _viewModel = responseModel.Data;
            _loading=false;
            
            _imageSrc = string.IsNullOrEmpty(_viewModel.ImageName) ? GetImagePath(DefaultAvatar) : GetImagePath(_viewModel.ImageName);
            
            _updateModel.FirstName = _viewModel.FirstName??string.Empty;
            _updateModel.LastName = _viewModel.LastName??string.Empty;
            _updateModel.DateOfBirth = _viewModel.DateOfBirth;
            _updateModel.ProfileDescription = _viewModel.ProfileDescription ?? string.Empty;
            
            _selectedGender = _viewModel.Gender?.ToString() ?? string.Empty;
            
            StateHasChanged();

        }
        
    }
    
    private async Task ResetForm(MudForm form)
    {
        await form.ResetAsync();
        await form.ResetValidationAsync();
        
        _updateErrors = Array.Empty<string>();
        _passwordErrors = Array.Empty<string>();
    }



}
